<?xml version='1.0'?>
<!DOCTYPE svg PUBLIC '-//W3C//DTD SVG 1.0//EN'
'http://www.w3.org/TR/2001/REC-SVG-20010904/DTD/svg10.dtd'>
<!-- totalHeight =13-->
<!-- totalWidth =50-->
<svg width='5in' height='2in' viewBox='0 0 50 13'>

  <defs>
    <style type='text/css'><![CDATA[
      rect {
        fill: white;
        stroke: grey;
        stroke-width: 0.1
      }
      text {
        font-size: 1;
      }
      line {
        stroke: black;
        stroke-width: 0.1
      }
      line.dash {
        stroke-dasharray: 1,1;
        stroke: black;
        stroke-width: 0.1
      }
    ]]></style>
    <marker id='Triangle'
      viewBox='0 0 10 10' refX='0' refY='5' 
      markerUnits='strokeWidth'
      markerWidth='4' markerHeight='3'
      orient='auto'>
      <path d='M 0 0 L 10 5 L 0 10 z' />
    </marker>
    <filter id='dropShadow' x='-.1' y='-.1' width='200' height='120'>
       <feOffset in='SourceGraphic' dx='0' dy='0' result='orig' />
       <feGaussianBlur in='SourceAlpha' stdDeviation='.3' result='shadow' />
       <feOffset in='shadow' dx='0' dy='.1' result='movedShadow' />
       <feMerge>
           <feMergeNode in='movedShadow' />
           <feMergeNode in='orig' />
       </feMerge>
    </filter>
  </defs>
<rect x='5.5' y='-2.0' width='9.0' height='2.0' rx='.6' ry='.6' filter='url(#dropShadow)'></rect>
 <text text-anchor='middle' y='-0.6' x='10.0'>
One
 </text> 
<line x1='10.0' y1='0.0' x2='10.0' y2='26'></line>
<rect x='15.5' y='-2.0' width='9.0' height='2.0' rx='.6' ry='.6' filter='url(#dropShadow)'></rect>
 <text text-anchor='middle' y='-0.6' x='20.0'>
Two
 </text> 
 <text text-anchor='middle' y='0.4' x='20.0'>
lines
 </text> 
<line x1='20.0' y1='0.0' x2='20.0' y2='26'></line>
<rect x='25.5' y='-2.0' width='9.0' height='2.0' rx='.6' ry='.6' filter='url(#dropShadow)'></rect>
 <text text-anchor='middle' y='-0.6' x='30.0'>
Four
 </text> 
 <text text-anchor='middle' y='0.4' x='30.0'>
line
 </text> 
 <text text-anchor='middle' y='1.4' x='30.0'>
caption
 </text> 
 <text text-anchor='middle' y='2.4' x='30.0'>
here
 </text> 
<line x1='30.0' y1='0.0' x2='30.0' y2='26'></line>
 <text y='7.8' x='10.2'>
x
 </text> 
 <line marker-end='url(#Triangle)' x1='10' y1='8' x2='19.6' y2='8'/>
 <text y='10.8' x='20.2'>
y
 </text> 
 <text y='11.8' x='20.2'>
z
 </text> 
 <line marker-end='url(#Triangle)' x1='20' y1='11' x2='29.6' y2='11'/>
</svg>
