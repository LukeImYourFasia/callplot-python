<html xmlns:v='urn:schemas-microsoft-com:vml'
xmlns='http://www.w3.org/TR/REC-html40'>

<head>

<!--[if !mso]>
<style>
v\:* {behavior:url(#default#VML);}
.shape {behavior:url(#default#VML);}
</style>
<![endif]-->

</head>

<body>
<!-- totalHeight =9-->
<!-- totalWidth =50-->
<v:group style='position:relative;left:1pt;top:2pt;width:216pt;height:77pt;' coordsize='50,18' >

<v:rect fillcolor='red' style='position:absolute;left:15.5;top:-4.0;width:9;height:4.0'>  <v:stroke     />
</v:rect> <v:shape fillcolor='black' strokeweight='0pt' coordorigin='0 0' coordsize='100 100' style='position:absolute;top:-1.8;left:15.8;width:9;height:4.0' path = 'm 0,0 l 100,0  e'>
 <v:path textpathok='True'/> 
 <v:textpath on='True' string="A" style='FONT-FAMILY:"courier new";FONT-SIZE:9pt;V-TEXT-ALIGN:center'/> 
 </v:shape> 
<v:line  from='20.0,0.0' to='20.0,18'>  <v:stroke   />
</v:line><v:rect fillcolor='red' style='position:absolute;left:25.5;top:-4.0;width:9;height:4.0'>  <v:stroke     />
</v:rect> <v:shape fillcolor='black' strokeweight='0pt' coordorigin='0 0' coordsize='100 100' style='position:absolute;top:-1.8;left:25.8;width:9;height:4.0' path = 'm 0,0 l 100,0  e'>
 <v:path textpathok='True'/> 
 <v:textpath on='True' string="B" style='FONT-FAMILY:"courier new";FONT-SIZE:9pt;V-TEXT-ALIGN:center'/> 
 </v:shape> 
<v:line  from='30.0,0.0' to='30.0,18'>  <v:stroke   />
</v:line> <v:shape fillcolor='black' strokeweight='0pt' coordorigin='0 0' coordsize='100 100' style='position:absolute;top:0;left:21;width:1;height:1' path = 'm 0,0 l 100,0  e'>
 <v:path textpathok='True'/> 
 <v:textpath on='True' string="x" style='FONT-FAMILY:"courier new";FONT-SIZE:9pt;V-TEXT-ALIGN:left' /> 
 </v:shape> 
 <v:line from='20,2' to='30,2'>
  <v:stroke     EndArrow='Open' />
 </v:line>
 <v:shape fillcolor='black' strokeweight='0pt' coordorigin='0 0' coordsize='100 100' style='position:absolute;top:8;left:21;width:1;height:1' path = 'm 0,0 l 100,0  e'>
 <v:path textpathok='True'/> 
 <v:textpath on='True' string="y" style='FONT-FAMILY:"courier new";FONT-SIZE:9pt;V-TEXT-ALIGN:left' /> 
 </v:shape> 
 <v:line from='30,10' to='20,10'>
  <v:stroke     EndArrow='Open' />
 </v:line>

</v:group>
</body>
</html>   
