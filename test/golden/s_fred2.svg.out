<?xml version='1.0'?>
<!DOCTYPE svg PUBLIC '-//W3C//DTD SVG 1.0//EN'
'http://www.w3.org/TR/2001/REC-SVG-20010904/DTD/svg10.dtd'>
<!-- totalHeight =31-->
<!-- totalWidth =55-->
<svg width='5in' height='5in' viewBox='0 0 55 31'>

  <defs>
    <style type='text/css'><![CDATA[
      rect {
        fill: white;
        stroke: grey;
        stroke-width: 0.1
      }
      text {
        font-size: 1;
      }
      line {
        stroke: black;
        stroke-width: 0.1
      }
      line.dash {
        stroke-dasharray: 1,1;
        stroke: black;
        stroke-width: 0.1
      }
    ]]></style>
    <marker id='Triangle'
      viewBox='0 0 10 10' refX='0' refY='5' 
      markerUnits='strokeWidth'
      markerWidth='4' markerHeight='3'
      orient='auto'>
      <path d='M 0 0 L 10 5 L 0 10 z' />
    </marker>
    <filter id='dropShadow' x='-.1' y='-.1' width='200' height='120'>
       <feOffset in='SourceGraphic' dx='0' dy='0' result='orig' />
       <feGaussianBlur in='SourceAlpha' stdDeviation='.3' result='shadow' />
       <feOffset in='shadow' dx='0' dy='.1' result='movedShadow' />
       <feMerge>
           <feMergeNode in='movedShadow' />
           <feMergeNode in='orig' />
       </feMerge>
    </filter>
  </defs>
<rect x='3.25' y='-2.0' width='13.5' height='2.0' rx='.6' ry='.6' filter='url(#dropShadow)'></rect>
 <text text-anchor='middle' y='-0.6' x='10.0'>
Fred
 </text> 
 <text text-anchor='middle' y='0.4' x='10.0'>
Flintstone
 </text> 
<line x1='10.0' y1='0.0' x2='10.0' y2='62'></line>
<rect x='18.25' y='-2.0' width='13.5' height='2.0' rx='.6' ry='.6' filter='url(#dropShadow)'></rect>
 <text text-anchor='middle' y='-0.6' x='25.0'>
Barney
 </text> 
 <text text-anchor='middle' y='0.4' x='25.0'>
Rubble
 </text> 
 <text text-anchor='middle' y='1.4' x='25.0'>
Esquire
 </text> 
<line x1='25.0' y1='0.0' x2='25.0' y2='62'></line>
 <text y='6.8' x='10.2'>
Please
 </text> 
 <text y='7.8' x='10.2'>
give
 </text> 
 <text y='8.8' x='10.2'>
me the ball.
 </text> 
 <line marker-end='url(#Triangle)' x1='10' y1='7' x2='24.6' y2='7'/>
 <text y='10.8' x='25.2'>
Gives
 </text> 
 <text y='11.8' x='25.2'>
bowling ball
 </text> 
 <text y='14.8' x='10.2'>
Stuff
 </text> 
 <line marker-end='url(#Triangle)' x1='25' y1='15' x2='10.4' y2='15'/>
 <text y='18.8' x='10.2'>
RTP
 </text> 
 <text y='19.8' x='10.2'>
(real-time
 </text> 
 <text y='20.8' x='10.2'>
protocol)
 </text> 
 <line class='dash' x1='25' y1='19' x2='10' y2='19'/>
 <text y='22.8' x='10.2'>
Thank You
 </text> 
 <line marker-end='url(#Triangle)' x1='10' y1='23' x2='24.6' y2='23'/>
 <text y='26.8' x='10.2'>
You're Welcome
 </text> 
 <line marker-end='url(#Triangle)' x1='25' y1='27' x2='10.4' y2='27'/>
</svg>
