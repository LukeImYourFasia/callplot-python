<?xml version='1.0'?>
<!DOCTYPE svg PUBLIC '-//W3C//DTD SVG 1.0//EN'
'http://www.w3.org/TR/2001/REC-SVG-20010904/DTD/svg10.dtd'>
<!-- totalHeight =20-->
<!-- totalWidth =70-->
<svg width='7in' height='3in' viewBox='0 0 70 20'>

  <defs>
    <style type='text/css'><![CDATA[
      rect {
        fill: white;
        stroke: grey;
        stroke-width: 0.1
      }
      text {
        font-size: 1;
      }
      line {
        stroke: black;
        stroke-width: 0.1
      }
      line.dash {
        stroke-dasharray: 1,1;
        stroke: black;
        stroke-width: 0.1
      }
    ]]></style>
    <marker id='Triangle'
      viewBox='0 0 10 10' refX='0' refY='5' 
      markerUnits='strokeWidth'
      markerWidth='4' markerHeight='3'
      orient='auto'>
      <path d='M 0 0 L 10 5 L 0 10 z' />
    </marker>
    <filter id='dropShadow' x='-.1' y='-.1' width='200' height='120'>
       <feOffset in='SourceGraphic' dx='0' dy='0' result='orig' />
       <feGaussianBlur in='SourceAlpha' stdDeviation='.3' result='shadow' />
       <feOffset in='shadow' dx='0' dy='.1' result='movedShadow' />
       <feMerge>
           <feMergeNode in='movedShadow' />
           <feMergeNode in='orig' />
       </feMerge>
    </filter>
  </defs>
<rect x='2.0' y='-2.0' width='16.0' height='2.0' rx='.6' ry='.6' filter='url(#dropShadow)'></rect>
 <text text-anchor='middle' y='-0.6' x='10.0'>
A
 </text> 
<line x1='10.0' y1='0.0' x2='10.0' y2='40'></line>
<rect x='12.0' y='2.0' width='16.0' height='2.0' rx='.6' ry='.6' filter='url(#dropShadow)'></rect>
 <text text-anchor='middle' y='3.4' x='20.0'>
B
 </text> 
<line x1='20.0' y1='4.0' x2='20.0' y2='40'></line>
<rect x='22.0' y='-2.0' width='16.0' height='2.0' rx='.6' ry='.6' filter='url(#dropShadow)'></rect>
 <text text-anchor='middle' y='-0.6' x='30.0'>
C
 </text> 
<line x1='30.0' y1='0.0' x2='30.0' y2='40'></line>
<rect x='32.0' y='2.0' width='16.0' height='2.0' rx='.6' ry='.6' filter='url(#dropShadow)'></rect>
 <text text-anchor='middle' y='3.4' x='40.0'>
D
 </text> 
<line x1='40.0' y1='4.0' x2='40.0' y2='40'></line>
<rect x='42.0' y='-2.0' width='16.0' height='2.0' rx='.6' ry='.6' filter='url(#dropShadow)'></rect>
 <text text-anchor='middle' y='-0.6' x='50.0'>
E
 </text> 
<line x1='50.0' y1='0.0' x2='50.0' y2='40'></line>
 <text y='7.8' x='10.2'>
one
 </text> 
 <line marker-end='url(#Triangle)' x1='10' y1='8' x2='19.6' y2='8'/>
 <text y='11.8' x='30.2'>
two
 </text> 
 <line marker-end='url(#Triangle)' x1='30' y1='12' x2='39.6' y2='12'/>
 <text y='15.8' x='10.2'>
three
 </text> 
 <line marker-end='url(#Triangle)' x1='50' y1='16' x2='10.4' y2='16'/>
</svg>
