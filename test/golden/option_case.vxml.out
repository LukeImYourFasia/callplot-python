<body>
<!-- totalHeight =9-->
<!-- totalWidth =52-->
<v:group style='position:relative;left:1pt;top:2pt;width:224pt;height:77pt;' coordsize='52,18' >

<v:rect fillcolor='red' style='position:absolute;left:4.0;top:-4.0;width:12;height:4.0'>  <v:stroke     />
</v:rect> <v:shape fillcolor='black' strokeweight='0pt' coordorigin='0 0' coordsize='100 100' style='position:absolute;top:-1.8;left:4.3;width:12;height:4.0' path = 'm 0,0 l 100,0  e'>
 <v:path textpathok='True'/> 
 <v:textpath on='True' string="A" style='FONT-FAMILY:"courier new";FONT-SIZE:9pt;V-TEXT-ALIGN:center'/> 
 </v:shape> 
<v:line  from='10.0,0.0' to='10.0,18'>  <v:stroke   />
</v:line><v:rect fillcolor='red' style='position:absolute;left:18.0;top:-4.0;width:12;height:4.0'>  <v:stroke     />
</v:rect> <v:shape fillcolor='black' strokeweight='0pt' coordorigin='0 0' coordsize='100 100' style='position:absolute;top:-1.8;left:18.3;width:12;height:4.0' path = 'm 0,0 l 100,0  e'>
 <v:path textpathok='True'/> 
 <v:textpath on='True' string="B" style='FONT-FAMILY:"courier new";FONT-SIZE:9pt;V-TEXT-ALIGN:center'/> 
 </v:shape> 
<v:line  from='24.0,0.0' to='24.0,18'>  <v:stroke   />
</v:line> <v:shape fillcolor='black' strokeweight='0pt' coordorigin='0 0' coordsize='100 100' style='position:absolute;top:8;left:11;width:1;height:1' path = 'm 0,0 l 100,0  e'>
 <v:path textpathok='True'/> 
 <v:textpath on='True' string="x" style='FONT-FAMILY:"courier new";FONT-SIZE:9pt;V-TEXT-ALIGN:left' /> 
 </v:shape> 
 <v:line from='10,10' to='24,10'>
  <v:stroke     EndArrow='Open' />
 </v:line>

</v:group>
