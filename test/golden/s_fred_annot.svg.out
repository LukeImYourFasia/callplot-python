<?xml version='1.0'?>
<!DOCTYPE svg PUBLIC '-//W3C//DTD SVG 1.0//EN'
'http://www.w3.org/TR/2001/REC-SVG-20010904/DTD/svg10.dtd'>
<!-- totalHeight =25-->
<!-- totalWidth =55-->
<svg width='5in' height='4in' viewBox='0 0 55 25'>

  <defs>
    <style type='text/css'><![CDATA[
      rect {
        fill: white;
        stroke: grey;
        stroke-width: 0.1
      }
      text {
        font-size: 1;
      }
      line {
        stroke: black;
        stroke-width: 0.1
      }
      line.dash {
        stroke-dasharray: 1,1;
        stroke: black;
        stroke-width: 0.1
      }
    ]]></style>
    <marker id='Triangle'
      viewBox='0 0 10 10' refX='0' refY='5' 
      markerUnits='strokeWidth'
      markerWidth='4' markerHeight='3'
      orient='auto'>
      <path d='M 0 0 L 10 5 L 0 10 z' />
    </marker>
    <filter id='dropShadow' x='-.1' y='-.1' width='200' height='120'>
       <feOffset in='SourceGraphic' dx='0' dy='0' result='orig' />
       <feGaussianBlur in='SourceAlpha' stdDeviation='.3' result='shadow' />
       <feOffset in='shadow' dx='0' dy='.1' result='movedShadow' />
       <feMerge>
           <feMergeNode in='movedShadow' />
           <feMergeNode in='orig' />
       </feMerge>
    </filter>
  </defs>
<rect x='3.25' y='-2.0' width='13.5' height='2.0' rx='.6' ry='.6' filter='url(#dropShadow)'></rect>
 <text text-anchor='middle' y='-0.6' x='10.0'>
Fred
 </text> 
<line x1='10.0' y1='0.0' x2='10.0' y2='50'></line>
<rect x='18.25' y='-2.0' width='13.5' height='2.0' rx='.6' ry='.6' filter='url(#dropShadow)'></rect>
 <text text-anchor='middle' y='-0.6' x='25.0'>
Barney
 </text> 
<line x1='25.0' y1='0.0' x2='25.0' y2='50'></line>
 <text y='4.8' x='10.2'>
Please
 </text> 
 <line marker-end='url(#Triangle)' x1='10' y1='5' x2='24.6' y2='5'/>
 <text y='8.8' x='25.2'>
Gives bowling ball
 </text> 
 <text y='12.8' x='10.2'>
Stuff
 </text> 
 <line marker-end='url(#Triangle)' x1='25' y1='13' x2='10.4' y2='13'/>
 <text y='16.8' x='10.2'>
Thank You
 </text> 
 <line marker-end='url(#Triangle)' x1='10' y1='17' x2='24.6' y2='17'/>
 <text y='20.8' x='10.2'>
You're Welcome
 </text> 
 <line marker-end='url(#Triangle)' x1='25' y1='21' x2='10.4' y2='21'/>
</svg>
