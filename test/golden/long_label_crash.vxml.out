<!-- totalWidth =35-->
<v:group style='position:relative;left:1pt;top:2pt;width:151pt;height:77pt;' coordsize='35,18' >

<v:rect fillcolor='red' style='position:absolute;left:0.5;top:-4.0;width:9;height:4.0'>  <v:stroke     />
</v:rect> <v:shape fillcolor='black' strokeweight='0pt' coordorigin='0 0' coordsize='100 100' style='position:absolute;top:-1.8;left:0.8;width:9;height:4.0' path = 'm 0,0 l 100,0  e'>
 <v:path textpathok='True'/> 
 <v:textpath on='True' string="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" style='FONT-FAMILY:"courier new";FONT-SIZE:9pt;V-TEXT-ALIGN:center'/> 
 </v:shape> 
<v:line  from='5.0,0.0' to='5.0,18'>  <v:stroke   />
</v:line><v:rect fillcolor='red' style='position:absolute;left:10.5;top:-4.0;width:9;height:4.0'>  <v:stroke     />
</v:rect> <v:shape fillcolor='black' strokeweight='0pt' coordorigin='0 0' coordsize='100 100' style='position:absolute;top:-1.8;left:10.8;width:9;height:4.0' path = 'm 0,0 l 100,0  e'>
 <v:path textpathok='True'/> 
 <v:textpath on='True' string="B" style='FONT-FAMILY:"courier new";FONT-SIZE:9pt;V-TEXT-ALIGN:center'/> 
 </v:shape> 
<v:line  from='15.0,0.0' to='15.0,18'>  <v:stroke   />
</v:line> <v:shape fillcolor='black' strokeweight='0pt' coordorigin='0 0' coordsize='100 100' style='position:absolute;top:8;left:6;width:1;height:1' path = 'm 0,0 l 100,0  e'>
 <v:path textpathok='True'/> 
 <v:textpath on='True' string="x" style='FONT-FAMILY:"courier new";FONT-SIZE:9pt;V-TEXT-ALIGN:left' /> 
