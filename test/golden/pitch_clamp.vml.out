<v:line  from='30.0,0.0' to='30.0,26'>  <v:stroke   />
</v:line> <v:shape fillcolor='black' strokeweight='0pt' coordorigin='0 0' coordsize='100 100' style='position:absolute;top:14;left:11;width:1;height:1' path = 'm 0,0 l 100,0  e'>
