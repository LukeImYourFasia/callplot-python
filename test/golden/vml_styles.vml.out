<body>
<!-- totalHeight =17-->
<!-- totalWidth =40-->
<v:group style='position:relative;left:1pt;top:2pt;width:172pt;height:146pt;' coordsize='40,34' >

<v:rect fillcolor='blue' style='position:absolute;left:4.0;top:-4.0;width:12;height:4.0'>  <v:stroke   foobar />
</v:rect> <v:shape fillcolor='black' strokeweight='0pt' coordorigin='0 0' coordsize='100 100' style='position:absolute;top:-1.8;left:4.3;width:12;height:4.0' path = 'm 0,0 l 100,0  e'>
 <v:path textpathok='True'/> 
 <v:textpath on='True' string="A" FONT-FAMILY:Custom;FONT-SIZE:8pt;V-TEXT-ALIGN:center/> 
 </v:shape> 
<v:line  from='10.0,0.0' to='10.0,34'>  <v:stroke foobar />
</v:line><v:rect fillcolor='blue' style='position:absolute;left:14.0;top:-4.0;width:12;height:4.0'>  <v:stroke   foobar />
</v:rect> <v:shape fillcolor='black' strokeweight='0pt' coordorigin='0 0' coordsize='100 100' style='position:absolute;top:-1.8;left:14.3;width:12;height:4.0' path = 'm 0,0 l 100,0  e'>
 <v:path textpathok='True'/> 
 <v:textpath on='True' string="B" FONT-FAMILY:Custom;FONT-SIZE:8pt;V-TEXT-ALIGN:center/> 
 </v:shape> 
<v:line  from='20.0,0.0' to='20.0,34'>  <v:stroke foobar />
</v:line> <v:shape fillcolor='black' strokeweight='0pt' coordorigin='0 0' coordsize='100 100' style='position:absolute;top:8;left:11;width:1;height:1' path = 'm 0,0 l 100,0  e'>
 <v:path textpathok='True'/> 
 <v:textpath on='True' string="one" FONT-FAMILY:Custom;FONT-SIZE:8pt /> 
 </v:shape> 
 <v:line from='10,10' to='20,10'>
  <v:stroke   foobar ArrowType='Double' />
 </v:line>
 <v:shape fillcolor='black' strokeweight='0pt' coordorigin='0 0' coordsize='100 100' style='position:absolute;top:16;left:11;width:1;height:1' path = 'm 0,0 l 100,0  e'>
 <v:path textpathok='True'/> 
 <v:textpath on='True' string="two" FONT-FAMILY:Custom;FONT-SIZE:8pt /> 
 </v:shape> 
 <v:line from='20,18' to='10,18'>
  <v:stroke DashStyle='dash'  foobar />
 </v:line>
 <v:shape fillcolor='black' strokeweight='0pt' coordorigin='0 0' coordsize='100 100' style='position:absolute;top:24;left:11;width:1;height:1' path = 'm 0,0 l 100,0  e'>
 <v:path textpathok='True'/> 
 <v:textpath on='True' string="n" FONT-FAMILY:Custom;FONT-SIZE:8pt /> 
